<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/otp_message_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingLeft="@dimen/activity_margin"
    android:paddingTop="@dimen/normal_margin"
    android:paddingRight="@dimen/activity_margin"
    android:paddingBottom="@dimen/normal_margin">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/otp_sender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/otp_date"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="@dimen/bigger_text_size"
        android:textStyle="bold"
        tools:text="Some Service" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/otp_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/otp_sender"
        android:layout_alignParentEnd="true"
        android:alpha="0.8"
        android:textSize="@dimen/normal_text_size"
        tools:text="10:15" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/otp_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/otp_sender"
        android:layout_marginTop="@dimen/small_margin"
        android:layout_toStartOf="@+id/otp_copy"
        android:fontFamily="monospace"
        android:textSize="@dimen/bigger_text_size"
        android:textStyle="bold"
        tools:text="123456" />

    <ImageView
        android:id="@+id/otp_copy"
        android:layout_width="@dimen/normal_icon_size"
        android:layout_height="@dimen/normal_icon_size"
        android:layout_alignTop="@+id/otp_code"
        android:layout_alignBottom="@+id/otp_code"
        android:layout_alignParentEnd="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/copy_code"
        android:padding="@dimen/tiny_margin"
        android:src="@drawable/ic_copy_vector" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/otp_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/otp_code"
        android:layout_marginTop="@dimen/small_margin"
        android:alpha="0.8"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="@dimen/normal_text_size"
        tools:text="Your verification code is 123456. Do not share it with anyone." />

</RelativeLayout>
